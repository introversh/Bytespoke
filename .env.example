# Environment Configuration Template
# Copy to .env and configure as needed. DO NOT commit .env with sensitive credentials.

# Database Configuration
PIPELINE_DB_PATH=pipeline_ops.db

# AI Intelligence Provider Configuration
# Options: 'heuristic' (default offline zero-config), 'ollama', 'openai'
AI_PROVIDER=heuristic

# Local LLM / OpenAI Endpoint (Optional, only used when AI_PROVIDER=llm or ollama)
AI_API_BASE=http://localhost:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=

# Pipeline Execution Settings
LOG_LEVEL=INFO
MAX_RETRIES=3
INITIAL_BACKOFF_SEC=0.25
BACKOFF_FACTOR=1.8
ENABLE_JITTER=true
